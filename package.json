{
  "name": "v-tech-software",
  "version": "1.71.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:local": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "next experimental-analyze",
    "analyze:output": "next experimental-analyze --output",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "perf:check": "node scripts/perf-budget.mjs",
    "schema:drift": "node scripts/check-schema-drift.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,mjs,cjs,json,css}\" \"*.{ts,mts,js,mjs,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,mjs,cjs,json,css}\" \"*.{ts,mts,js,mjs,json,css}\"",
    "version:patch": "npm version patch -m \"chore(release): v%s [skip ci]\" && git push --follow-tags",
    "version:minor": "npm version minor -m \"chore(release): v%s [skip ci]\" && git push --follow-tags",
    "version:major": "npm version major -m \"chore(release): v%s [skip ci]\" && git push --follow-tags",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "dependencies": {
