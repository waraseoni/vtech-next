    "@simplewebauthn/server": "^14.0.3",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.4",
    "@types/jsbarcode": "^3.11.4",
    "date-fns": "^4.4.0",
    "firebase-admin": "^14.3.0",
