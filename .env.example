# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Sentry (OPTIONAL — error monitoring)
# Set karne par errors server + browser dono par track hote hain.
# DSN: https://<key>@<org>.ingest.sentry.io/<project>
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
# SENTRY_DSN=your_sentry_dsn

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# License (SELLER ke central licensing project ke liye — ALAG Supabase project hai)
# docs/licensing/central-project.sql is project par run karke ye do values yahan daalo.
# Har shop ke app mein same LICENSE_SERVICE_URL/ANON_KEY set hota hai.
LICENSE_SERVICE_URL=your_licensing_project_url
LICENSE_SERVICE_ANON_KEY=your_licensing_anon_key

# License re-check interval (ghante). Default 24h. Kam karne se seller ki
# delete/revoke/expiry jaldi (lekin zyada central calls ke saath) lagti hai.
# LICENSE_RECHECK_HOURS=1

# ─── Seller / Developer Portals (sirf SELLER ke APNE deployment par set karein) ───
# LICENSE_SERVICE_SERVICE_ROLE_KEY = central licensing project ka Service Role key.
#   ⚠️ Ye kabhi customer ke deployment par MAT daalo — isse licensing DB par CRUD khulta hai.
# SELLER_PORTAL_PASSWORD / DEV_PORTAL_PASSWORD = portals ke alag-alag passwords.
#   Password ke bina portal band rahega (in sab ke bina /seller aur /developer 403 dete hain).
LICENSE_SERVICE_SERVICE_ROLE_KEY=your_licensing_service_role_key
SELLER_PORTAL_PASSWORD=change-me-seller-portal
DEV_PORTAL_PASSWORD=change-me-dev-portal

# Client credentials (Supabase service-role / GitHub / Vercel tokens) encrypt karne ke liye.
# Koi bhi strong secret dalo. Nahi dala to LICENSE_SERVICE_SERVICE_ROLE_KEY se derive hoga —
# par alag key recommended hai (usko rotate karo to sab client creds decrypt nahi honge).
# SELLER_CREDS_ENCRYPTION_KEY=change-me-strong-secret

# Setup page token (OPTIONAL, client package ke liye): isse /setup page par admin
# sirf token ke saath bana sakta hai. Har client ko alag token do (package script
# se generate ho sakta hai). Bisaake pehla aadmi hi admin ban sakta hai.
# SETUP_TOKEN=change-me-client-setup-token

# ─── Public site branding (OPTIONAL, per-client) ─────────────────────────────
# Har client ke apne Vercel project par ye vars set hote hain (Developer portal ke
# "Push Env & Redeploy" se). Set hone par client ki public site apni branding dikhati
# hai; nahi hone par default seller branding (V-Technologies) aati hai.
# Services list: comma-separated slugs — stage-lighting, industrial, power-supply.
# NEXT_PUBLIC_SITE_NAME=V-Technologies
# NEXT_PUBLIC_SITE_SHORT_NAME=V-Tech
# NEXT_PUBLIC_SITE_TAGLINE=Repair & Service Experts
# NEXT_PUBLIC_SITE_PHONE=+91 91791 05875
# NEXT_PUBLIC_SITE_EMAIL=vtech.jbp@gmail.com
# NEXT_PUBLIC_SITE_ADDRESS=F4 Hotel Plaza (Madhushala), Besides Jayanti Complex, Marhatal, Jabalpur, MP 482002
# NEXT_PUBLIC_SITE_OWNER=Vikram Jain
# NEXT_PUBLIC_SITE_SERVICES=stage-lighting,industrial,power-supply

# ─── Push Notifications (100% Free — VAPID) ────────────────────────────────
# VAPID keys generate karo: npx web-push generate-vapid-keys
# PUBLIC key browser ko jaata hai (NEXT_PUBLIC_ prefix zaroori hai for client-side).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID_EMAIL=mailto:admin@yourdomain.com

# WhatsApp (Optional - for future use)
# WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_id
# WHATSAPP_ACCESS_TOKEN=your_whatsapp_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_WEBHOOK_SECRET=your_webhook_secret
